# 5% fee / bot-win receive address (public). Not the house signer.
VITE_TREASURY_WALLET=259nG2nNP8GjCKRYqrcpsEJ14qfrra5yabjpU6axs7We
TREASURY_WALLET=259nG2nNP8GjCKRYqrcpsEJ14qfrra5yabjpU6axs7We

# House oracle pubkey (HOUSE_SECRET_KEY's public key). Baked into the SPA as a fallback.
# VITE_ORACLE_WALLET=

# mainnet-beta | devnet | testnet — keep devnet until a two-wallet payout works.
VITE_SOLANA_CLUSTER=devnet

# Optional custom RPC (Helius, QuickNode, etc.)
# VITE_SOLANA_RPC=https://api.devnet.solana.com

# Per-match escrow program (see solana/arcade-escrow/README.md)
VITE_ESCROW_PROGRAM_ID=96kU3yLXf5agsoBGzTCQvtYxqAfm4vQV1XdZYKh95512
ESCROW_PROGRAM_ID=96kU3yLXf5agsoBGzTCQvtYxqAfm4vQV1XdZYKh95512

# Supabase project cbfyrkxzgtxoypewdouf
# https://supabase.com/dashboard/project/cbfyrkxzgtxoypewdouf
VITE_SUPABASE_URL=https://cbfyrkxzgtxoypewdouf.supabase.co
# Project Settings → API → publishable / anon key (Realtime broadcast only; never the service_role key)
VITE_SUPABASE_ANON_KEY=

# Prisma: pooled URL (port 6543) + direct URL (port 5432) for migrations.
# Project Settings → Database → Connection string (URI).
DATABASE_URL="postgresql://postgres.cbfyrkxzgtxoypewdouf:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.cbfyrkxzgtxoypewdouf:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=3001

# Railway (one service for site + API + WS): leave CORS_ORIGINS and VITE_API_ORIGIN unset.
# Only set these if the SPA is on a different host than Node.
# CORS_ORIGINS=https://clashr.example.com
# VITE_API_ORIGIN=https://api.clashr.example.com

# SOL pots turn on when HOUSE_SECRET_KEY is set and the escrow program is executable.
# Do not set VITE_ENABLE_SOL_POTS.
# HOUSE_SECRET_KEY is the oracle signer (bs58 or JSON byte array). Node only. Never VITE_*.
# It does not need to match TREASURY_WALLET — fees go to TREASURY_WALLET.
# HOUSE_SECRET_KEY=
# SOLANA_RPC=https://api.devnet.solana.com
