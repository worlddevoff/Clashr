generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id
  username    String
  avatar      String
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  account     CreditAccount?
  ledger      LedgerEntry[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nonce     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthNonce {
  nonce     String   @id
  address   String
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

model CreditAccount {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  balance   Int
  updatedAt DateTime @updatedAt
}

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  matchId   String?
  kind      String
  amount    Int
  note      String
  createdAt DateTime @default(now())
}

model Match {
  id           String   @id
  seed         Int
  status       String
  winnerId     String?
  prize        Int      @default(0)
  gross        Int      @default(0)
  platformFee  Int      @default(0)
  settled      Boolean  @default(false)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  participants MatchParticipant[]
  events       ReplayEvent[]
  moments      DetectedMoment[]
}

model MatchParticipant {
  matchId        String
  userId         String
  username       String
  avatar         String
  color          String
  isBot          Boolean
  placement      Int?
  floorsReached  Int      @default(1)
  shoves         Int      @default(0)
  fallsSurvived  Int      @default(0)
  creditsWon     Int      @default(0)
  match          Match    @relation(fields: [matchId], references: [id])
  @@id([matchId, userId])
}

model ReplayEvent {
  id      String @id @default(cuid())
  matchId String
  t       Float
  kind    String
  payload String
  match   Match  @relation(fields: [matchId], references: [id])
}

model DetectedMoment {
  id       String @id @default(cuid())
  matchId  String
  kind     String
  headline String
  player   String
  avatar   String
  color    String
  stat     String
  match    Match  @relation(fields: [matchId], references: [id])
}

model LeaderboardRow {
  userId      String @id
  username    String
  avatar      String
  color       String
  wins        Int    @default(0)
  gamesPlayed Int    @default(0)
  biggestWin  Int    @default(0)
  streak      Int    @default(0)
  updatedAt   DateTime @updatedAt
}
